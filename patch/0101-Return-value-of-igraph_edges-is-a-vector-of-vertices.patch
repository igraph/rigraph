From: =?UTF-8?q?Kirill=20M=C3=BCller?= <kirill@cynkra.com>
Date: Sun, 2 Nov 2025 12:23:28 +0100
Subject: [PATCH] Return value of igraph_edges() is a vector of vertices

---
 src/vendor/cigraph/interfaces/functions.yaml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/vendor/cigraph/interfaces/functions.yaml b/src/vendor/cigraph/interfaces/functions.yaml
index 8e91d53..efde442 100644
--- a/src/vendor/cigraph/interfaces/functions.yaml
+++ b/src/vendor/cigraph/interfaces/functions.yaml
@@ -83,8 +83,8 @@ igraph_edge:
     FLAGS: no_rng
 
 igraph_edges:
-    PARAMS: GRAPH graph, EDGE_SELECTOR eids, OUT VECTOR_INT edges, BOOLEAN bycol=False
-    DEPS: eids ON graph
+    PARAMS: GRAPH graph, EDGE_SELECTOR eids, OUT VERTEX_INDICES edges, BOOLEAN bycol=False
+    DEPS: eids ON graph, edges ON graph
     FLAGS: no_rng
 
 igraph_get_eid:
-- 

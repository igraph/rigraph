From 383a139bf405b631160159f6443d64c11ea0823a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 15:48:09 +0000
Subject: [PATCH] Keep the vendored Qhull from referencing stderr in R builds

R CMD check reports compiled code that references stderr. Qhull falls back
to stderr for its error stream in qh_meminit() and qh_new_qhull(), and
qh_fprintf_stderr() writes to it. With USING_R defined, the fallback is
qh_FILEstderr, Qhull's own stand-in for stderr, qh_fprintf() drops what goes
there as it drops what goes to a NULL stream, and qh_fprintf_stderr() prints
nothing, as plfit's error handler does in R builds.
---
 src/vendor/cigraph/vendor/qhull/libqhull_r/mem_r.c        | 8 ++++++++
 src/vendor/cigraph/vendor/qhull/libqhull_r/user_r.c       | 4 ++++
 src/vendor/cigraph/vendor/qhull/libqhull_r/usermem_r.c    | 6 ++++++
 src/vendor/cigraph/vendor/qhull/libqhull_r/userprintf_r.c | 7 +++++++
 4 files changed, 25 insertions(+)

diff --git a/src/vendor/cigraph/vendor/qhull/libqhull_r/mem_r.c b/src/vendor/cigraph/vendor/qhull/libqhull_r/mem_r.c
index 57e80edda9..90e530a595 100644
--- a/src/vendor/cigraph/vendor/qhull/libqhull_r/mem_r.c
+++ b/src/vendor/cigraph/vendor/qhull/libqhull_r/mem_r.c
@@ -307,7 +307,11 @@ void qh_meminit(qhT *qh, FILE *ferr) {
   if (ferr)
     qh->qhmem.ferr= ferr;
   else
+#ifdef USING_R
+    qh->qhmem.ferr= qh_FILEstderr; /* R packages must not write to stderr */
+#else
     qh->qhmem.ferr= stderr;
+#endif
   if (sizeof(void *) < sizeof(int)) {
     qh_fprintf(qh, qh->qhmem.ferr, 6083, "qhull internal error (qh_meminit): sizeof(void *) %d < sizeof(int) %d.  qset_r.c will not work\n", (int)sizeof(void*), (int)sizeof(int));
     qh_exit(qhmem_ERRqhull);  /* can not use qh_errexit() */
@@ -511,7 +515,11 @@ void qh_meminit(qhT *qh, FILE *ferr) {
   if (ferr)
       qh->qhmem.ferr= ferr;
   else
+#ifdef USING_R
+      qh->qhmem.ferr= qh_FILEstderr; /* R packages must not write to stderr */
+#else
       qh->qhmem.ferr= stderr;
+#endif
   if (sizeof(void *) < sizeof(int)) {
     qh_fprintf(qh, qh->qhmem.ferr, 6091, "qhull internal error (qh_meminit): sizeof(void *) %d < sizeof(int) %d.  qset_r.c will not work\n", (int)sizeof(void*), (int)sizeof(int));
     qh_errexit(qh, qhmem_ERRqhull, NULL, NULL);
diff --git a/src/vendor/cigraph/vendor/qhull/libqhull_r/user_r.c b/src/vendor/cigraph/vendor/qhull/libqhull_r/user_r.c
index 70eab8b156..02bc7b4578 100644
--- a/src/vendor/cigraph/vendor/qhull/libqhull_r/user_r.c
+++ b/src/vendor/cigraph/vendor/qhull/libqhull_r/user_r.c
@@ -131,7 +131,11 @@ int qh_new_qhull(qhT *qh, int dim, int numpoints, coordT *points, boolT ismalloc
   coordT *new_points;
 
   if(!errfile){
+#ifdef USING_R
+    errfile= qh_FILEstderr; /* R packages must not write to stderr */
+#else
     errfile= stderr;
+#endif
   }
   if (!qh->qhmem.ferr) {
     qh_meminit(qh, errfile);
diff --git a/src/vendor/cigraph/vendor/qhull/libqhull_r/usermem_r.c b/src/vendor/cigraph/vendor/qhull/libqhull_r/usermem_r.c
index 27563cff4a..73beaf55cf 100644
--- a/src/vendor/cigraph/vendor/qhull/libqhull_r/usermem_r.c
+++ b/src/vendor/cigraph/vendor/qhull/libqhull_r/usermem_r.c
@@ -63,6 +63,7 @@ void qh_exit(int exitcode) {
     Use qh_fprintf [userprintf_r.c] for normal printing
 */
 void qh_fprintf_stderr(int msgcode, const char *fmt, ... ) {
+#ifndef USING_R
     va_list args;
 
     va_start(args, fmt);
@@ -70,6 +71,11 @@ void qh_fprintf_stderr(int msgcode, const char *fmt, ... ) {
       fprintf(stderr, "QH%.4d ", msgcode);
     vfprintf(stderr, fmt, args);
     va_end(args);
+#else
+    /* R packages must not write to stderr. */
+    IGRAPH_UNUSED(msgcode);
+    IGRAPH_UNUSED(fmt);
+#endif
 } /* fprintf_stderr */
 
 /*-<a                             href="qh-user_r.htm#TOC"
diff --git a/src/vendor/cigraph/vendor/qhull/libqhull_r/userprintf_r.c b/src/vendor/cigraph/vendor/qhull/libqhull_r/userprintf_r.c
index 7eb3600b34..05527618d0 100644
--- a/src/vendor/cigraph/vendor/qhull/libqhull_r/userprintf_r.c
+++ b/src/vendor/cigraph/vendor/qhull/libqhull_r/userprintf_r.c
@@ -44,6 +44,13 @@
 
 void qh_fprintf(qhT *qh, FILE *fp, int msgcode, const char *fmt, ... ) {
     va_list args;
+#ifdef USING_R
+    /* R builds use qh_FILEstderr in place of stderr, which R packages must
+     * not write to. Drop what goes there, as for a NULL stream. */
+    if (fp == qh_FILEstderr) {
+        fp = NULL;
+    }
+#endif
     if (qh) {
         if (msgcode >= MSG_ERROR && msgcode < MSG_WARNING) {
             qh->last_errcode = msgcode;
-- 
2.55.0

